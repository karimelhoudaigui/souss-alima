generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VerificationStatus {
  EXAMPLE
  TO_VERIFY
  SOURCED
}

enum MadrassaStatus {
  ACTIVE
  HERITAGE_ONLY
  UNKNOWN
}

enum ContributionStatus {
  PENDING
  APPROVED
  REJECTED
}

model Scholar {
  id              String             @id @default(cuid())
  slug            String             @unique
  nameFr          String
  nameAr          String
  transliteration String?
  nisba           String?
  birthDate       String?
  deathDate       String?
  birthPlace      String?
  deathPlace      String?
  biography       String
  portraitUrl     String?
  verification    VerificationStatus @default(TO_VERIFY)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  articleLinks ArticleScholar[]
  madrassas    ScholarMadrassa[]
  sources      ScholarSource[]
  teachers     ScholarRelation[]  @relation("ScholarStudents")
  students     ScholarRelation[]  @relation("ScholarTeachers")
  works        Work[]
}

model ScholarRelation {
  id        String @id @default(cuid())
  teacherId String
  studentId String
  note      String?

  teacher Scholar @relation("ScholarTeachers", fields: [teacherId], references: [id], onDelete: Cascade)
  student Scholar @relation("ScholarStudents", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([teacherId, studentId])
}

model Madrassa {
  id            String             @id @default(cuid())
  slug          String             @unique
  nameFr        String
  nameAr        String?
  village       String?
  commune       String?
  province      String?
  latitude      Float?
  longitude     Float?
  history       String?
  currentStatus MadrassaStatus     @default(UNKNOWN)
  tolbaCount    Int?
  contactName   String?
  contactEmail  String?
  contactPhone  String?
  photoUrl      String?
  verification  VerificationStatus @default(TO_VERIFY)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  articleLinks ArticleMadrassa[]
  scholars     ScholarMadrassa[]
}

model Travel {
  id            String             @id @default(cuid())
  slug          String             @unique
  title         String
  duration      String
  dates         String?
  price         String?
  itinerary     Json
  program       Json
  practicalInfo String
  gallery       Json?
  verification  VerificationStatus @default(TO_VERIFY)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

model Source {
  id         String   @id @default(cuid())
  title      String
  author     String?
  sourceType String
  citation   String
  url        String?
  notes      String?
  createdAt  DateTime @default(now())

  articleLinks ArticleSource[]
  scholars     ScholarSource[]
}

model ScholarSource {
  scholarId String
  sourceId  String
  note      String?

  scholar Scholar @relation(fields: [scholarId], references: [id], onDelete: Cascade)
  source  Source  @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([scholarId, sourceId])
}

model Work {
  id        String @id @default(cuid())
  scholarId String
  title     String
  notes     String?

  articleLinks ArticleWork[]
  scholar      Scholar       @relation(fields: [scholarId], references: [id], onDelete: Cascade)
}

model ScholarMadrassa {
  scholarId  String
  madrassaId String
  role       String?

  scholar  Scholar  @relation(fields: [scholarId], references: [id], onDelete: Cascade)
  madrassa Madrassa @relation(fields: [madrassaId], references: [id], onDelete: Cascade)

  @@id([scholarId, madrassaId])
}

model Theme {
  id    String @id @default(cuid())
  slug  String @unique
  label String

  articles ArticleTheme[]
}

model Article {
  id           String             @id @default(cuid())
  slug         String             @unique
  title        String
  titleAr      String?
  summary      String
  body         String
  author       String?
  publishedAt  DateTime?
  readingTime  String?
  verification VerificationStatus @default(TO_VERIFY)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  themes    ArticleTheme[]
  sources   ArticleSource[]
  scholars  ArticleScholar[]
  madrassas ArticleMadrassa[]
  works     ArticleWork[]
  tags      ArticleTag[]
}

model ArticleTheme {
  articleId String
  themeId   String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  theme   Theme   @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([articleId, themeId])
}

model ArticleSource {
  articleId String
  sourceId  String
  note      String?

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  source  Source  @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([articleId, sourceId])
}

model ArticleScholar {
  articleId String
  scholarId String
  note      String?

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  scholar Scholar @relation(fields: [scholarId], references: [id], onDelete: Cascade)

  @@id([articleId, scholarId])
}

model ArticleMadrassa {
  articleId  String
  madrassaId String
  note       String?

  article  Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  madrassa Madrassa @relation(fields: [madrassaId], references: [id], onDelete: Cascade)

  @@id([articleId, madrassaId])
}

model ArticleWork {
  articleId String
  workId    String
  note      String?

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  work    Work    @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@id([articleId, workId])
}

model ArticleTag {
  id        String @id @default(cuid())
  articleId String
  label     String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model GlossaryTerm {
  id         String @id @default(cuid())
  termFr     String
  termAr     String?
  definition String
  theme      String?
}

model Contribution {
  id        String             @id @default(cuid())
  name      String
  email     String
  topic     String
  payload   Json
  status    ContributionStatus @default(PENDING)
  createdAt DateTime           @default(now())
}
